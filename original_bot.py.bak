57: from aiogram.client.session.middlewares.base import BaseRequestMiddleware
58: from aiogram.exceptions import TelegramBadRequest
59: 
60: class SafeMarkdownMiddleware(BaseRequestMiddleware):
61:     """
62:     Globally intercepts Telegram entity parsing errors and custom emoji incompatibilities,
63:     automatically converting text emojis into Telegram Premium custom emojis (<tg-emoji>)
64:     and applying native animated custom emoji icons to all buttons.
65:     Ensures zero user-facing error crashes.
66:     """
67:     async def __call__(self, make_request, bot, method):
68:         # 1. Automatically enrich all keyboard buttons with Telegram Premium custom emojis
69:         if hasattr(method, "reply_markup") and method.reply_markup is not None:
70:             try:
71:                 from utils.emojis import apply_premium_emojis_to_keyboard
72:                 method.reply_markup = apply_premium_emojis_to_keyboard(method.reply_markup)
73:             except Exception:
74:                 pass
75: 
76:         # 2. Automatically enrich outgoing message text & caption with Telegram Premium animated emojis (<tg-emoji>)
77:         try:
78:             from utils.emojis import prepare_premium_message_content
79:             pm = getattr(method, "parse_mode", None)
80:             if hasattr(method, "text") and method.text:
81:                 new_text, new_pm = prepare_premium_message_content(method.text, pm)
82:                 method.text = new_text
83:                 if new_pm:
84:                     method.parse_mode = new_pm
85:             if hasattr(method, "caption") and method.caption:
86:                 new_caption, new_pm = prepare_premium_message_content(method.caption, pm)
87:                 method.caption = new_caption
88:                 if new_pm:
89:                     method.parse_mode = new_pm
90:         except Exception:
91:             pass
92: 
93:         try:
94:             return await make_request(bot, method)
95:         except TelegramBadRequest as e:
96:             err_msg = str(e).lower()
97:             if "can't parse entities" in err_msg or "can't find end of the entity" in err_msg:
98:                 if hasattr(method, "parse_mode") and method.parse_mode is not None:
99:                     logger.warning(f"Auto-handled Markdown entity error in {type(method).__name__}. Retrying with parse_mode=None.")
100:                     method.parse_mode = None
101:                     return await make_request(bot, method)
102:             if "custom_emoji" in err_msg or "emoji_invalid" in err_msg or "button" in err_msg and "emoji" in err_msg:
103:                 if hasattr(method, "reply_markup") and method.reply_markup is not None:
104:                     from utils.emojis import strip_button_custom_emojis
105:                     logger.warning(f"Auto-handled custom emoji restriction in {type(method).__name__}. Retrying without button custom emojis.")
106:                     method.reply_markup = strip_button_custom_emojis(method.reply_markup)
107:                     return await make_request(bot, method)
108:             raise e
