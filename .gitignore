# ===== Reseller Bot .gitignore =====

# Environment / Secrets -- NEVER commit
.env

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/

# Database runtime locks and temporary files -- NEVER commit
database/*.db-shm
database/*.db-wal
database/*.bak

# Local backup archives
backups/
database/backups/
*.zip
*.tar.gz
*.bak

# Log files
*.log
bot.log

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Stale / leftover variant files
*.original
*.v1
*.v2
*.df134
*.bak
